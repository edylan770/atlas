# Set this to the deployed commit SHA before building the Docker image.
APP_BUILD_ID=development

# --- VLM / LLM provider ---
# Supported: "bedrock" (default), "openai", or "anthropic".
VLM_PROVIDER=bedrock
LLM_PROVIDER=bedrock

# Bedrock model IDs (cross-region inference profile recommended).
VLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- AWS / Bedrock auth ---
AWS_REGION=us-east-1
# Cohere Rerank 3.5 is not available in us-east-2; use us-east-1 or us-west-2.
# Easiest: paste a short-lived Bedrock API key here. boto3 picks it up automatically.
# AWS_BEARER_TOKEN_BEDROCK=
# Or use standard AWS credentials (aws configure, AWS_ACCESS_KEY_ID/SECRET, SSO, etc.).

# --- Optional cloud providers ---
# Only needed if you switch VLM_PROVIDER / LLM_PROVIDER to "openai" or "anthropic".
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Nano Banana 2 (Gemini image edit) ---
# Prefer GEMINI_API_KEY for local/dev. In production the app loads the key from
# AWS Secrets Manager (default secret name "gemini" in us-east-1).
# Secret value may be a plaintext API key OR JSON:
#   {"api_key":"..."} / {"API_KEY":"..."} / {"GEMINI_API_KEY":"..."} /
#   {"gemini_api_key":"..."}
# IAM: grant the task/instance role secretsmanager:GetSecretValue on
#   arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:gemini-*
# GEMINI_API_KEY=
# GEMINI_SECRET_NAME=gemini
# GEMINI_SECRET_REGION=us-east-1
# NANO_BANANA_MODEL=gemini-3.1-flash-image

# --- Bedrock embedding / reranking ---
# Titan works in us-east-1; many regions (e.g. us-east-2) need Cohere Embed v4 instead:
#   EMBEDDING_MODEL=us.cohere.embed-v4:0
EMBEDDING_MODEL=amazon.titan-embed-image-v1
EMBEDDING_DIM=1024
RERANKER_MODEL=cohere.rerank-v3-5:0

# --- Caption-text dense lane ---
# Text-to-text retrieval over caption documents (third hybrid lane).
# Disable if the text embedding model is unavailable in your region.
CAPTION_TEXT_LANE_ENABLED=true
TEXT_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
TEXT_EMBEDDING_DIM=1024

# --- Storage paths (relative to project root unless absolute) ---
DATA_DIR=./data
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/imagecb.db
IMAGE_CACHE_DIR=./data/images
UPLOADS_DIR=./data/uploads
BM25_PATH=./data/bm25.pkl
HUBNESS_PATH=./data/hubness.pkl

# Durable corpus blobs. Keep "local" for development. On EC2 use "s3" with
# an instance role; do not place long-lived AWS access keys in this file.
BLOB_STORAGE_BACKEND=local
# S3_BUCKET=your-private-corpus-bucket
S3_PREFIX=imagecb
# S3_REGION=us-east-1
# Bound failed S3 calls so an ingest job reports IAM/network errors promptly.
# S3_CONNECT_TIMEOUT=10
# S3_READ_TIMEOUT=120
# S3_MAX_RETRIES=3
# Browser PUT URLs expire after this many seconds (60-86400).
# S3_PRESIGN_EXPIRY_SEC=3600
# Optional alternate endpoint used only when signing browser upload URLs
# (e.g. MinIO playground: http://localhost:9000 while AWS_ENDPOINT_URL_S3=http://minio:9000).
# S3_PRESIGN_ENDPOINT_URL=

# --- Ingest performance ---
# Keep workers low on small instances; large concurrent ingest can OOM (~125 images).
INGEST_WORKERS=2
INGEST_MAX_IMAGE_SIDE=1024
THUMB_MAX_SIDE=256
THUMB_JPEG_QUALITY=80
INGEST_BATCH_UPSERT=16
# Max files processed per worker cycle for one job (remainder requeues on same job_id).
INGEST_JOB_CHUNK_SIZE=25
# CLI file batching (0 = single run; 25 recommended for large corpora)
# INGEST_BATCH_SIZE=25
# Write a per-run timing .txt under {S3_PREFIX}/ingest-logs/ (or DATA_DIR when local).
# INGEST_TIMING_LOG=true
# Per-query stage timing (Admin Search quality + optional {S3_PREFIX}/query-logs/*.txt).
# QUERY_TIMING_LOG=true
# QUERY_TIMING_PERSIST=true

# Optional bootstrap corpus: directory auto-ingested in a background thread on
# startup when the index is empty (seeds a small smoke-test set on a fresh
# deploy, e.g. ECS). Empty disables it. The Docker image sets this to
# /app/corpus/smoke.
# BOOTSTRAP_CORPUS_DIR=
# INGEST_IMAGE_TIMEOUT_SEC=300
# BEDROCK_MAX_CONCURRENT=2
# BEDROCK_READ_TIMEOUT=120
# BEDROCK_CONNECT_TIMEOUT=10
# BEDROCK_MAX_RETRIES=6

# --- Post-ingest index repair ---
# Automatically fix missing cached PNGs, failed captions, and missing Chroma vectors.
POST_INGEST_REPAIR_ENABLED=true
POST_INGEST_REPAIR_INCLUDE_WEAK=false
POST_INGEST_REPAIR_REINDEX_VECTORS=true

# --- Index consistency ---
# Safe cross-store reconcile (orphan vector purge, BM25 rebuild) on startup and after ingest.
INDEX_RECONCILE_ON_STARTUP=true
INDEX_RECONCILE_AFTER_INGEST=true

# --- S3 index durability (recommended when BLOB_STORAGE_BACKEND=s3) ---
# Checkpoint local SQLite/Chroma to S3 during ingest; auto-restore if local data is empty on boot.
# INDEX_CHECKPOINT_ENABLED=true
INDEX_CHECKPOINT_EVERY_N=10
INDEX_AUTO_RESTORE_ON_STARTUP=true

# --- OCR ---
# Path to the Tesseract binary. Leave empty if it is on PATH.
# TESSERACT_CMD=   # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe on Windows

# --- Deck suggest (slide-aware image suggestions) ---
DECK_CACHE_DIR=./data/deck_cache
DECK_LLM_BATCH_SIZE=10
DECK_MAX_SLIDES=200
DECK_MAX_CHARS_PER_SLIDE=6000
DECK_MAX_UPLOAD_BYTES=52428800
DECK_CACHE_ENABLED=true

# --- Admin / telemetry ---
# Required for /api/admin/* and POST /api/ingest. Use a long random secret.
ADMIN_API_KEY=
WEAK_RESULT_SCORE_THRESHOLD=0.25
# Admin search/interaction analytics on blob backend (S3 or DATA_DIR), not SQLite.
TELEMETRY_BACKEND=blob
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_DEFAULT_WINDOW_DAYS=90
DUPLICATE_SIMILARITY_THRESHOLD=0.95

# CSLS-style hubness correction for the visual lane. Demotes "hub" images that
# are close to almost any query, so short-query results respond to the actual
# query instead of vector-space centrality. KNN sets the neighbourhood size for
# the per-image density estimate; PENALTY_WEIGHT scales the (mean-centred) penalty.
HUBNESS_CORRECTION_ENABLED=true
HUBNESS_KNN=10
HUBNESS_PENALTY_WEIGHT=0.5

# --- Concurrency & abuse protection (added in stability/security hardening) ---
# Idle chat sessions are evicted after this TTL; the store is LRU-capped.
SESSION_TTL_SEC=7200
SESSION_MAX_COUNT=1000
# Worker pool for follow-up suggestion generation (scale with concurrent chats).
FOLLOW_UP_WORKERS=8
# Per-client-IP requests/minute across LLM-backed endpoints (chat, similar,
# deck). 0 disables.
LLM_RATE_LIMIT_PER_MINUTE=30
# Comma-separated browser origins allowed by CORS (set to your real domain in
# production; defaults cover local dev).
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8081,http://localhost:8081

# Verbatim visible-text source for search documents: vlm (default; VLM reads
# text during captioning - faster and more accurate in A/B testing), both
# (adds Tesseract OCR; consider for dense small-text corpora), tesseract.
OCR_SOURCE=vlm

# --- Latency tuning (Phase 3) ---
# Overlap query embedding with the parse LLM call (reused when the parsed
# query equals the raw text).
SPECULATIVE_QUERY_EMBED=true
# Concurrent per-slide searches during deck suggest (bounded by
# BEDROCK_MAX_CONCURRENT globally).
DECK_SEARCH_WORKERS=4
# TTL for the cached index-health report behind /api/status and /api/ready.
STATUS_CACHE_TTL_SEC=30

# --- Additional retrieval / suggestion tuning (documented during audit) ---
# Queries with <= this many tokens use the widened short-query retrieval pool.
SHORT_QUERY_MAX_TOKENS=2
SHORT_QUERY_RERANK_TOP_N=100
SHORT_QUERY_RETRIEVAL_TOP_K=100
# Max characters of caption context appended to image embeddings at ingest.
EMBED_CONTEXT_MAX_CHARS=480
# Multiplier applied to results whose asset_type matches the query intent.
ASSET_TYPE_RERANK_BOOST=1.10
# LLM-written conversational replies (template fallback when disabled).
ENABLE_CONVERSATIONAL_LLM=true
# Suggested-query generation cache and limits.
SUGGESTIONS_CACHE_TTL_SEC=300
SUGGESTIONS_LIMIT=4
FOLLOW_UP_SUGGESTIONS_LIMIT=3
ENABLE_FOLLOW_UP_SUGGESTIONS=true
# Near-duplicate collapsing in result lists.
RESULT_DEDUPLICATE_ENABLED=true
RESULT_DEDUPLICATE_SIMILARITY_THRESHOLD=0.995

# Ranking lane ablation: disable the visual (image-vector) lane to rank purely
# on caption-text embeddings, or disable CAPTION_TEXT_LANE_ENABLED for
# visual-only. At least one must stay enabled.
VISUAL_LANE_ENABLED=true
